              "raw": "{\n  \"orderId\": \"order_id_here\",\n  \"amount\": 59.98,\n  \"currency\": \"USD\",\n  \"provider\": \"stripe\",\n  \"paymentMethod\": {\n    \"card\": {\n      \"number\": \"4242424242424242\",\n      \"exp_month\": 12,\n      \"exp_year\": 2025,\n      \"cvc\": \"123\"\n    }\n  }\n}",
